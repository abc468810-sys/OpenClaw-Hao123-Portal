# OpenClaw Hao123 Portal 环境变量示例

# OpenAI / 图片 / 视频接口密钥，仅后续接入真实生成服务时使用
OPENAI_API_KEY=
SORA_API_KEY=
SEEDANCE_API_KEY=
RUNWAY_API_KEY=

# 汇率设置，可后续改成实时接口
RUB_CNY_RATE=0.078
USD_CNY_RATE=7.2
USDT_CNY_RATE=7.2

# 数据采集模式
# manual: 人工录入
# api: 官方 API
# public: 低频公开页面研究
DATA_COLLECTION_MODE=manual

# 合规开关
ENABLE_PUBLIC_DATA_COLLECTION=false
ENABLE_AUTO_PUBLISH=false
